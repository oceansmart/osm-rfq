{
  "name": "osm-rfq-frontend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "stagewise": "stagewise -s",
    "stagewise:storybook": "stagewise -a 6006 -p 6007 -s",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed",
    "figma:create-primitive": "ts-node --project tsconfig.scripts.json scripts/figma/create-primitive-collection.ts",
    "figma:update-primitive": "ts-node --project tsconfig.scripts.json scripts/figma/update-primitive-variables.ts",
    "docs:validate": "cd .. && npm run docs:validate",
    "docs:serve": "cd .. && npm run docs:serve",
    "docs:build": "cd .. && npm run docs:build",
    "docs:deploy": "cd .. && npm run docs:deploy",
    "prepare": "husky"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.2.2",
    "@tailwindcss/typography": "^0.5.19",
    "@tanstack/react-query": "^5.90.5",
    "@untitledui/icons": "^0.0.19",
    "clsx": "^2.1.1",
    "glob": "^10.5.0",
    "lightningcss": "^1.30.2",
    "next": "14.2.33",
    "next-themes": "^0.4.6",
    "react": "^18",
    "react-aria-components": "^1.13.0",
    "react-dom": "^18",
    "react-hook-form": "^7.65.0",
    "storybook": "^9.1.13",
    "tailwind-merge": "^3.3.1",
    "tailwindcss-animate": "^1.0.7",
    "tailwindcss-react-aria-components": "^2.0.1",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@chromatic-com/storybook": "^4.1.1",
    "@playwright/test": "^1.56.1",
    "@storybook/addon-a11y": "^9.1.13",
    "@storybook/addon-docs": "^9.1.13",
    "@storybook/addon-onboarding": "^9.1.13",
    "@storybook/addon-vitest": "^9.1.13",
    "@storybook/nextjs": "^9.1.13",
    "@tailwindcss/postcss": "^4.1.17",
    "@types/node": "^20",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "autoprefixer": "^10.4.22",
    "eslint": "^8",
    "eslint-config-next": "14.2.33",
    "eslint-plugin-storybook": "^9.1.13",
    "husky": "^9.1.7",
    "js-yaml": "^4.1.0",
    "postcss": "^8.5.6",
    "tailwindcss": "^4.1.17",
    "ts-node": "^10.9.2",
    "typescript": "^5"
  },
  "overrides": {
    "glob": "^10.5.0"
  }
}
